{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "thermalexpo-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8200"
      ],
      "port": 8200
    },
    {
      "name": "thermalexpo-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5190
    }
  ]
}