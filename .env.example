# ============================ Thermo-Shield India — environment ============================
# Copy to .env (the backend reads ../.env or backend/.env). NEVER commit .env. No secret is ever sent to the frontend.

# --- Database: PostgreSQL + PostGIS (docker compose: postgres service on host port 5434).
# Leave empty to use a local SQLite file (development / tests only; no PostGIS).
DATABASE_URL=postgresql+psycopg://thermoshield:thermoshield@localhost:5434/thermoshield

# --- Auth (JWT). Generate a long random secret: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# e-mail verification code validity
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# comma-separated e-mails that become ADMIN on registration
BOOTSTRAP_ADMIN_EMAILS=
# the very first registered account becomes ADMIN
FIRST_USER_IS_ADMIN=true
# empty = any domain; e.g. gmail.com,gov.in
ALLOWED_EMAIL_DOMAINS=
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Gmail SMTP two-step verification + live alert e-mails (use a Gmail App Password, never your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
SMTP_USE_TLS=true
# true (development only, SMTP unset): write e-mails to the backend log instead of sending
EMAIL_DEV_LOG_ONLY=false

# --- NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Without a key the keyless public regional
#     feed is used (last 24h/48h/7d only); the key enables the area API and the 12-month historical archive backfill.
NASA_FIRMS_API_KEY=
NASA_FIRMS_MAP_KEY=
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT
FIRMS_ARCHIVE_SOURCES=VIIRS_SNPP_SP,MODIS_SP
# India bounding box W,S,E,N (rows are then filtered by the OSM India polygon)
FIRMS_AREA=68,6,98,38
FIRMS_DAYS=2
FIRMS_PUBLIC_REGION=South_Asia
# 24h | 48h | 7d
FIRMS_PUBLIC_WINDOW=48h
FIRMS_PUBLIC_SOURCES=suomi-npp,noaa-20,noaa-21,modis
FIRMS_POLL_MINUTES=120
# observation newer than this at ingestion => LIVE (else HISTORICAL)
LIVE_WINDOW_HOURS=48
LIVE_INGEST_ON_STARTUP=true
# Nominatim/Overpass/weather enrichment for the top-N priority events per run
LIVE_ENRICH_MAX=120
LIVE_OSM_MIN_FRP=10
ENABLE_SCHEDULER=true
BACKGROUND_VISUALS=true
BACKGROUND_VISUALS_MAX=40
AUTO_GENERATE_PDF=true

# --- Weather / wind: open-meteo (keyless; current + ERA5 archive) | none
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# --- OpenStreetMap context: overpass (live Overpass + Nominatim) | reference (bundled gazetteer only)
OSM_PROVIDER=overpass
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_ENABLED=true

# --- Optical satellite: stac (Sentinel-2 L2A via Earth Search, keyless) | none. Copernicus credentials optional.
SATELLITE_PROVIDER=stac
STAC_URL=https://earth-search.aws.element84.com/v1
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# osm (OSM land-use polygons) | reference (coarse zones only)
LANDCOVER_PROVIDER=osm
POPULATION_DATA_SOURCE=census_2011_gazetteer

# --- Live alerts (defaults; an ADMIN can change them in Settings → Alerts). Nothing is sent until SMTP is configured.
ALERTS_ENABLED=true
# comma-separated e-mails
ALERT_RECIPIENTS=
ALERT_COOLDOWN_HOURS=12
ALERT_MIN_CONFIDENCE=0

# --- URLs / CORS
FRONTEND_URL=http://localhost:5190
BACKEND_URL=http://localhost:8200
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,http://localhost:3001
ENVIRONMENT=development
LOG_LEVEL=INFO
